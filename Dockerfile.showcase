# ui.messer.wtf — the generated showcase. Nothing is committed: the page is built from
# canon/tokens.json and brand/*.json at image build time, so it cannot describe a system we do not ship.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && npm run showcase

# busybox httpd, not nginx: one static directory, no config, ~1 MB. Caddy terminates TLS.
FROM busybox:stable
COPY --from=build /app/showcase/dist /srv
EXPOSE 8080
CMD ["httpd", "-f", "-p", "8080", "-h", "/srv"]
