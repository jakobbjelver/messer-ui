{
  "$description": "The family, for scripts that need to look across repos (dupes, contact sheet, block drift). Paths expand ~; sinks are filled when a dev server is up. iconFamily overrides rule 9 per brand (canon §14). blockDeviations declares a deliberate per-app divergence with its reason; wip apps are reported but not gated.",
  "apps": [
    {
      "id": "messer-swipe",
      "path": "~/Repos/messer-swipe",
      "brand": "messer-swipe",
      "shell": "none",
      "sink": null,
      "iconFamily": "lucide",
      "blockDeviations": {
        "status-badge": "Lucide family (§9 exception) plus a paused state — the block is Phosphor-only"
      }
    },
    {
      "id": "portal",
      "path": "~/Repos/messer-portal",
      "brand": "portal",
      "shell": "topbar",
      "marksTarget": "~/Repos/messer-portal/web/public/res",
      "sink": null
    },
    {
      "id": "ai-router",
      "path": "~/Repos/messer-ai-router",
      "brand": "ai-router",
      "shell": "topbar",
      "marksTarget": "~/Repos/messer-ai-router/packages/dashboard/public",
      "sink": null
    },
    {
      "id": "studio",
      "path": "~/Repos/site",
      "brand": "studio",
      "shell": "none",
      "sink": null
    },
    {
      "id": "news",
      "path": "~/Repos/messer-news",
      "brand": "news",
      "shell": "topbar",
      "sink": null,
      "wip": true
    },
    {
      "id": "messer",
      "path": "~/Repos/messer",
      "brand": "messer",
      "shell": "topbar",
      "marksTarget": "~/Repos/messer/public",
      "sink": null
    },
    {
      "id": "request-games",
      "path": "~/Repos/messer-request-games",
      "brand": "request-games",
      "shell": "sidebar",
      "sink": null,
      "wip": true
    },
    {
      "id": "transcode",
      "path": "~/Repos/messer-transcode",
      "brand": "transcode",
      "shell": "topbar",
      "marksTarget": "~/Repos/messer-transcode/web/app/public",
      "sink": null,
      "wip": true
    }
  ]
}
