    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "messer-fingerprint",
      "type": "registry:style",
      "title": "Messer UI — fingerprint",
      "description": "The ten rules as CSS: heading voices, one label style, tabular numbers, hairline borders, square focus, reduced motion. No colours.",
      "css": {
        "*": {
          "border-color": "var(--border)"
        },
        "::selection": {
          "background-color": "var(--primary)",
          "color": "var(--primary-foreground)"
        },
        ":focus-visible": {
          "outline": "2px solid var(--ring)",
          "outline-offset": "2px",
          "border-radius": "0"
        },
        "html": {
          "font-family": "var(--font-sans)"
        },
        "body": {
          "background-color": "var(--background)",
          "color": "var(--foreground)",
          "font-family": "var(--font-sans)",
          "font-size": "14px",
          "font-weight": "400",
          "line-height": "1.5",
          "font-variant-numeric": "tabular-nums"
        },
        "h1": {
          "font-family": "var(--font-sans)",
          "font-size": "32px",
          "font-weight": "600",
          "line-height": "1.1",
          "letter-spacing": "-0.02em"
        },
        "h2": {
          "font-family": "var(--font-sans)",
          "font-size": "24px",
          "font-weight": "600",
          "line-height": "1.15",
          "letter-spacing": "-0.015em"
        },
        "h3": {
          "font-family": "var(--font-mono)",
          "font-size": "16px",
          "font-weight": "500",
          "line-height": "1.3"
        },
        "h4": {
          "font-family": "var(--font-mono)",
          "font-size": "14px",
          "font-weight": "500",
          "line-height": "1.35"
        },
        "h5, h6": {
          "font-family": "var(--font-mono)",
          "font-size": "14px",
          "font-weight": "500",
          "line-height": "1.35"
        },
        ".prose": {
          "font-family": "var(--font-sans)",
          "font-size": "15px",
          "font-weight": "400",
          "line-height": "1.6"
        },
        ".m-small, small": {
          "font-family": "var(--font-sans)",
          "font-size": "12.5px",
          "font-weight": "400",
          "line-height": "1.45"
        },
        ".m-label": {
          "font-family": "var(--font-mono)",
          "font-size": "10.5px",
          "font-weight": "500",
          "line-height": "1",
          "letter-spacing": "0.1em",
          "text-transform": "uppercase",
          "color": "var(--text-3)"
        },
        ".m-data": {
          "font-family": "var(--font-mono)",
          "font-size": "12px",
          "font-weight": "400",
          "line-height": "1.3",
          "font-variant-numeric": "tabular-nums"
        },
        "code, kbd, pre, samp": {
          "font-family": "var(--font-mono)",
          "font-size": "12.5px",
          "font-weight": "400",
          "line-height": "1.4"
        },
        "table": {
          "font-variant-numeric": "tabular-nums"
        }
      }
