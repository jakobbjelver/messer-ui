{
  "$description": "Messer UI canon. The only hand-authored values in the system. Build with `npm run build`.",
  "color": {
    "light": {
      "$type": "color",
      "bg": {
        "$value": "#fafafa"
      },
      "surface": {
        "$value": "#ffffff"
      },
      "surface-2": {
        "$value": "#f2f2f2"
      },
      "border": {
        "$value": "#e4e4e4"
      },
      "border-strong": {
        "$value": "#d4d4d4"
      },
      "text": {
        "$value": "#141414"
      },
      "text-2": {
        "$value": "#525252"
      },
      "text-3": {
        "$value": "#6f6f6f"
      },
      "danger": {
        "$value": "oklch(0.55 0.19 25)"
      },
      "warning": {
        "$value": "oklch(0.70 0.14 75)"
      },
      "success": {
        "$value": "oklch(0.53 0.13 150)"
      },
      "on-status": {
        "$value": "#ffffff"
      }
    },
    "dark": {
      "$type": "color",
      "bg": {
        "$value": "#0a0a0a"
      },
      "surface": {
        "$value": "#141414"
      },
      "surface-2": {
        "$value": "#1c1c1c"
      },
      "border": {
        "$value": "#2a2a2a"
      },
      "border-strong": {
        "$value": "#3a3a3a"
      },
      "text": {
        "$value": "#f2f2f2"
      },
      "text-2": {
        "$value": "#a3a3a3"
      },
      "text-3": {
        "$value": "#8a8a8a"
      },
      "danger": {
        "$value": "oklch(0.68 0.17 25)"
      },
      "warning": {
        "$value": "oklch(0.80 0.13 75)"
      },
      "success": {
        "$value": "oklch(0.70 0.12 150)"
      },
      "on-status": {
        "$value": "#0a0a0a"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": "\"Golos Text\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "$value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace"
    }
  },
  "type": {
    "$type": "typography",
    "h1": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "32px",
        "fontWeight": 600,
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em"
      }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "24px",
        "fontWeight": 600,
        "lineHeight": "1.15",
        "letterSpacing": "-0.015em"
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "16px",
        "fontWeight": 500,
        "lineHeight": "1.3",
        "letterSpacing": "0"
      }
    },
    "h4": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": "1.35",
        "letterSpacing": "0"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "1.5"
      }
    },
    "prose": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": "1.6"
      }
    },
    "small": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "12.5px",
        "fontWeight": 400,
        "lineHeight": "1.45"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "10.5px",
        "fontWeight": 500,
        "lineHeight": "1",
        "letterSpacing": "0.1em"
      }
    },
    "data": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": "1.3"
      }
    },
    "code": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "12.5px",
        "fontWeight": 400,
        "lineHeight": "1.4"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "2px"
    },
    "2": {
      "$value": "4px"
    },
    "3": {
      "$value": "6px"
    },
    "4": {
      "$value": "8px"
    },
    "5": {
      "$value": "12px"
    },
    "6": {
      "$value": "16px"
    },
    "8": {
      "$value": "24px"
    },
    "10": {
      "$value": "32px"
    },
    "12": {
      "$value": "48px"
    },
    "16": {
      "$value": "64px"
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "0px"
    },
    "md": {
      "$value": "0px"
    },
    "lg": {
      "$value": "0px"
    },
    "xl": {
      "$value": "0px"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "size": {
    "$type": "dimension",
    "ctl-sm": {
      "$value": "28px"
    },
    "ctl": {
      "$value": "32px"
    },
    "ctl-lg": {
      "$value": "36px"
    },
    "row": {
      "$value": "36px"
    },
    "row-sm": {
      "$value": "32px"
    },
    "icon": {
      "$value": "16px"
    },
    "page": {
      "$value": "32px"
    },
    "shell": {
      "$value": "1200px"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "mid": {
        "$value": "180ms"
      },
      "slow": {
        "$value": "240ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "pop": {
      "$value": {
        "color": "rgb(0 0 0 / 0.12)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    }
  }
}
